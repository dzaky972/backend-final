APP_NAME="IMA Creative API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Frontend URL (untuk CORS Sanctum)
FRONTEND_URL=http://localhost:5173

# Tambahan origin lain (opsional, dipisah koma)
# Contoh: CORS_EXTRA_ORIGINS=http://192.168.1.100:5173,http://10.0.0.5:5173
CORS_EXTRA_ORIGINS=

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=backend_jasa
DB_USERNAME=root
DB_PASSWORD=

# Sanctum Stateful Domain
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SESSION_DOMAIN=localhost
SESSION_DRIVER=cookie

# Cache & Queue
CACHE_STORE=database
QUEUE_CONNECTION=database

# Midtrans (sandbox)
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXXXXXX
MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXXXXXX
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# Mail (opsional)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@ima.test"
MAIL_FROM_NAME="${APP_NAME}"
